{
  "private": true,
  "name": "server",
  "version": "1.0.0",
  "description": "Colyseus + Discord Embedded App SDK",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/discord-embedded-app-sdk#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.2",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.19",
    "@colyseus/tools": "^0.18.3",
    "colyseus": "^0.18.3",
    "express": "^5.2.1"
  }
}
